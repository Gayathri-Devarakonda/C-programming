#include <stdio.h>
int main()
{
int a[10][10],b[10][10],c[10][10];
int r1,r2,col1,col2,i,j,k;
printf("enter number of rows ans columns for both matrices");
scanf("%d %d %d %d",&r1,&r2,&col1,&col2);
if(col1!=r2)
printf("matrix multiplication is not possible");
else {
printf("enter elements of first matrix:  ")
for(i=0;i<r1;i++) {
for(j=0;j<col1;j++)
scanf("%d",&a[i][j]);
}
printf("enter elements of second matrix  ");
for(i=0;i<r2;i++){
for(j=0;j<col2,j++)
scanf("%d",&b[i][j]);
}
for(i=0;i<r1;i++) {
for(j=0;j<col2;j++) {
c[i][j]=0;
for(k=0;k<col1;k++)
c[i][j]=c[i][j]+a[i][k]*b[k][j];
}
}
printf("product of matrices:  ");
for(i=0;i<r1;i++) {
for(j=0;j<col2;j++)
printf("%3d",c[i][j]);
printf("\n");
}
}
return 0;
}
