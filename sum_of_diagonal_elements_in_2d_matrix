#include <stdio.h>
int main()
{
int a[10][10],n,i,j,sum=0;
printf("enter order of matrix:  ");
scanf("%d",&n);
printf("enter elements of matrix:  ");
for(i=0;i<n;i++) {
for(j=0;j<n;j++)
scanf("%d",&a[i][j]);
}
for(i=0;i<n;i++)
sum=sum+a[i][i];
printf("sum of diagonal elemnts is %d ",sum);
return 0;
}
