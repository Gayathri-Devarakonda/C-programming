#include <stdio.h>
int main()
{
int a[10][10],b[10][10],c[10][10];
int i,j,r,col;
printf("enter number of rows and columns");
scanf("%d %d",&r,&col);
printf("enter elements of matrix 1");
for(i=0;i<r;i++) {
for(j=0;j<col;j++) 
scanf("%d",&a[i][j]);
}
printf("enter elements of matrix 2");
for(i=0;i<r;i++) {
for(j=0;j<col:j++)
scanf("%d",&b[i][j]);
}
for(i=0;i<r;i++) {
for(j=0;j<col;j++) {
c[i][j]=a[i][j]+b[i][j];
printf("sum of matrices:");
printf("%d",c[i][j]);
}
printf("\n");
}
return 0;
}
